# ---------------------------------------------------------------------------
# Umbrix environment variables
# Copy to .env.local for local dev, or set these in your Vercel Project Settings.
# NEXT_PUBLIC_* values are exposed to the browser (safe for Firebase client keys).
# ---------------------------------------------------------------------------

# --- Database (required to persist data) -----------------------------------
# Without this the app runs in demo mode (localStorage + mock data).
MONGODB_URI=

# --- Firebase Authentication (client SDK — public by design) ----------------
# When a real project id is set, the server enforces auth on all /api routes,
# verifying Firebase ID tokens against Google's public certs (no service
# account needed). Leave as placeholders to run in demo mode.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# --- Rate limiting (Upstash Redis via Vercel Marketplace) -------------------
# Optional. When set, public/expensive endpoints are rate-limited. When unset,
# rate limiting is disabled (fails open). Provision "Upstash Redis" from the
# Vercel Marketplace and it injects these automatically.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Site URL (used for metadata, robots.txt canonical host) ----------------
# The app's public origin, no trailing slash. Falls back to https://umbrix.vercel.app.
NEXT_PUBLIC_SITE_URL=https://umbrix.vercel.app

# --- Billing (entitlement layer is provider-agnostic; provider TBD) ----------
# No keys required yet: with none set, every user resolves to the free tier and
# premium features stay locked. When a provider is chosen (Stripe / Paddle /
# Lemon Squeezy), add its secret + webhook-signing keys here and implement
# src/lib/billing/<provider>.ts against the BillingProvider interface.
# BILLING_PROVIDER=
# BILLING_SECRET_KEY=
# BILLING_WEBHOOK_SECRET=

# --- Ingest: aggregator API keys (optional; each source degrades gracefully) --
# Adzuna (all-field India aggregator) — free key at https://developer.adzuna.com
# ADZUNA_APP_ID=
# ADZUNA_APP_KEY=
# Jooble (job aggregator, strong India coverage) — free key at https://jooble.org/api/about
# The jooble-in-* shards in scripts/companies.json are already wired; set this to
# turn the source on. No code changes needed.
# JOOBLE_API_KEY=
